version 1.0

workflow merge_clinical_data {

    meta {
        author: "Allison Cheney"
        email: "archeney@ucsc.edu"
        description: "Add user-supplied clinical data files to gnomad and clinvar variant data using local VRS computation (no network calls)"
    }

    parameter_meta {
        GENE_NAME: "Optional prefix for the output file name. Default: merged"
        VARIANTS_FILE: "The gnomad and clinvar calibration variants file generated by previous workflows."
        FUNCTIONAL_SCORES: "File with functional assay scores VCF or HGVS cDNA or HGVS genomic variant names"
        CLINICAL_DATA: "File with user-supplied case data and VCF or HGVS cDNA or HGVS genomic variant names"
        VARIANT_ID_COLUMN_VARIANTS: "Column in VARIANTS_FILE holding the variant ID. Default: CERFAC_variant_id_VCF_gnomad if present, else auto-detected VCF-style column"
        VARIANT_ID_COLUMN_FUNCTIONAL: "Column in FUNCTIONAL_SCORES holding the variant ID. Default: auto-detected VCF-style column, else chr/pos/ref/alt (see FUNCTIONAL_LOCUS_COLUMNS)"
        VARIANT_ID_COLUMN_CLINICAL: "Column in CLINICAL_DATA holding the variant ID. Default: auto-detected VCF-style column, else second column"
        FUNCTIONAL_LOCUS_COLUMNS: "Comma-separated chr,pos,ref,alt columns in FUNCTIONAL_SCORES, used when no variant ID column is found. Default: auto-detected by name"
    }
    input {
        String? GENE_NAME
        File VARIANTS_FILE
        File FUNCTIONAL_SCORES
        File CLINICAL_DATA
        String VARIANT_TYPE = "gnomad"
        String? VARIANT_ID_COLUMN_VARIANTS
        String? VARIANT_ID_COLUMN_FUNCTIONAL
        String? VARIANT_ID_COLUMN_CLINICAL
        String? FUNCTIONAL_LOCUS_COLUMNS
    }

    # Compute VRS digests for each input file using local Docker image (no network)
    call compute_vrs_for_variants as vrs_variants {
        input:
            variants_file=VARIANTS_FILE,
            variant_type=VARIANT_TYPE,
            output_name="variants_with_vrs.csv",
            variant_id_column=VARIANT_ID_COLUMN_VARIANTS
    }

    call compute_vrs_for_variants as vrs_scores {
        input:
            variants_file=FUNCTIONAL_SCORES,
            variant_type="functional_assay",
            output_name="functional_scores_with_vrs.csv",
            variant_id_column=VARIANT_ID_COLUMN_FUNCTIONAL,
            locus_columns=FUNCTIONAL_LOCUS_COLUMNS
    }

    call compute_vrs_for_variants as vrs_clinical {
        input:
            variants_file=CLINICAL_DATA,
            variant_type="clinical",
            output_name="clinical_data_with_vrs.csv",
            variant_id_column=VARIANT_ID_COLUMN_CLINICAL
    }

    # Merge the VRS-annotated files
    call merge_vrs_files {
        input:
            gene_name=select_first([GENE_NAME, "merged"]),
            variants_file=vrs_variants.output_file,
            functional_scores_file=vrs_scores.output_file,
            clinical_data_file=vrs_clinical.output_file
    }

    output {
        File output_combined_variants_file = merge_vrs_files.output_file
    }
}


task compute_vrs_for_variants {
    input {
        File variants_file
        String variant_type
        String output_name
        String? variant_id_column
        String? locus_columns
        Int mem_gb = 4
        Int cpu = 2
        Int disk_gb = 100
    }

    command <<<
        cp ~{variants_file} variants.csv
        python3 /usr/local/bin/compute_vrs_digests.py \
            --input variants.csv \
            --output ~{output_name} \
            --variant-type ~{variant_type} \
            ~{if defined(variant_id_column) then "--variant-id-column " + select_first([variant_id_column]) else ""} \
            ~{if defined(locus_columns) then "--locus-columns " + select_first([locus_columns]) else ""}
    >>>

    output {
        File output_file = output_name
    }

    runtime {
        docker: "brcachallenge/cerfac@sha256:6be013392eac1debbff1f7e8273877b6bbb5d494ef8fb7abe8ed9ffb8294bf9c"
        memory: mem_gb + " GB"
        cpu: cpu
    }
}


task merge_vrs_files {
    input {
        String gene_name
        File variants_file
        File functional_scores_file
        File clinical_data_file
        Int mem_gb = 8
        Int cpu = 2
        Int disk_gb = 100
    }

    command <<<
        pip install -q pandas
        python3 << 'MERGE_CODE'
        import pandas as pd
        import sys

        # Read all three VRS-annotated files
        variants_df = pd.read_csv("~{variants_file}")
        scores_df = pd.read_csv("~{functional_scores_file}")
        clinical_df = pd.read_csv("~{clinical_data_file}")

        # Merge on VRS ID columns
        # The VRS computation adds: vrs_id, vrs_digest, genomic_hgvs, vrs_start, vrs_end, vrs_error
        merged = variants_df.copy()

        # VRS columns to exclude from merge (already in variants_df)
        vrs_cols = {'vrs_id', 'vrs_digest', 'genomic_hgvs', 'vrs_start', 'vrs_end', 'vrs_error'}

        # Merge functional scores - include all cols except VRS duplicates
        if 'vrs_id' in scores_df.columns:
            if 'vrs_id' in merged.columns:
                scores_subset = scores_df[[col for col in scores_df.columns if col not in vrs_cols or col == 'vrs_id']]
                merged = merged.merge(scores_subset, on='vrs_id', how='left', suffixes=('', '_scores'))

        # Merge clinical data - include all cols except VRS duplicates
        if 'vrs_id' in clinical_df.columns:
            if 'vrs_id' in merged.columns:
                clinical_subset = clinical_df[[col for col in clinical_df.columns if col not in vrs_cols or col == 'vrs_id']]
                merged = merged.merge(clinical_subset, on='vrs_id', how='left', suffixes=('', '_clinical'))

        # Write output
        merged.to_csv("~{gene_name}_variants_functional_clinical.csv", index=False)
        print(f"Merged {len(merged)} variants with VRS digests")
        print(f"Output: ~{gene_name}_variants_functional_clinical.csv")

        MERGE_CODE
    >>>

    output {
        File output_file = gene_name + "_variants_functional_clinical.csv"
    }

    runtime {
        docker: "python:3.11"
        memory: mem_gb + " GB"
        cpu: cpu
    }
}
